{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SEH-OS/DTC-Conformance/schemas/v0/conformance-report.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["claim_id", "claim_version", "claim_type", "generated_at", "claimant", "evaluator", "standard", "suite", "subject", "targets", "outcome", "validation_evidence", "limitations", "certification_status"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1}, "claim_version": {"const": "0.1.0"}, "claim_type": {"const": "self_assessment_test_evidence"}, "generated_at": {"type": "string", "format": "date-time"},
    "claimant": {"type": "object", "additionalProperties": false, "required": ["party_id"], "properties": {"party_id": {"const": "dtc-conformance-harness"}}},
    "evaluator": {"type": "object", "additionalProperties": false, "required": ["party_id", "independent", "contributor", "conflicts_disclosed"], "properties": {"party_id": {"const": "dtc-conformance-harness"}, "independent": {"const": false}, "contributor": {"const": true}, "conflicts_disclosed": {"const": true}}},
    "standard": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "tag"], "properties": {"repository": {"const": "https://github.com/SEH-OS/DTC-Standard"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tag": {"type": "string", "minLength": 1}}},
    "suite": {"type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": {"repository": {"const": "https://github.com/SEH-OS/DTC-Conformance"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["subject_type", "subject_id", "artifact_digest"], "properties": {"subject_type": {"enum": ["standard", "profile_instance", "mapping"]}, "subject_id": {"type": "string", "minLength": 1}, "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "outcome": {"enum": ["pass", "fail", "inconclusive"]},
    "validation_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["procedure", "outcome", "artifact_digest"], "properties": {"procedure": {"type": "string", "minLength": 1}, "outcome": {"enum": ["pass", "fail"]}, "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "limitations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "certification_status": {"const": "not_certified"}
  },
  "allOf": [{"if": {"properties": {"outcome": {"const": "fail"}}}, "then": {"required": ["findings"]}}]
}
